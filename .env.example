# Copy this file to .env and fill in real values. .env is never committed.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Email. Leave unset in development: emails are saved as .eml files in sent_emails/.
# For real sending (example values):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=user@example.com
# EMAIL_HOST_PASSWORD=app-password-here
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=auction@example.com

# Aadhaar / PAN encryption. REQUIRED. Generate with:  python manage.py generate_secret_keys
# Back these up: losing FIELD_ENCRYPTION_KEYS makes the stored numbers unreadable forever.
# To rotate: put the new key FIRST, keep the old one after it (comma-separated).
FIELD_ENCRYPTION_KEYS=paste-generated-key-here
IDENTITY_HASH_KEY=paste-generated-key-here

# Auction placeholders (NOT official SAIL values)
# AUCTION_TITLE=Vacant Quarter Auction (Training Demo)
# AUCTION_REFERENCE=DEMO/QA/2026/01
# SBI_COLLECT_PAYEE=SAIL Bokaro Steel Plant - Quarter Auction EMD (DEMO)

# Sign-up email code (OTP)
# OTP_VALID_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_SENDS_PER_EMAIL_PER_HOUR=5
# OTP_SENDS_PER_IP_PER_HOUR=20
# SIGNUP_VERIFIED_WINDOW_MINUTES=30

# Brute-force protection for login
# AUTH_RATE_LIMIT_ATTEMPTS=5
# AUTH_RATE_LIMIT_IP_ATTEMPTS=50
# AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# Register for bidding
# MAX_QUARTERS_PER_APPLICANT=2
# APPLICATION_CLOSES_HOURS_BEFORE_AUCTION=24

# Auctions and bidding (placeholders, NOT official rules)
# DEFAULT_AUCTION_DURATION_MINUTES=5
# DEFAULT_INCREMENT_PERCENT=0.20
# AUCTION_MAX_EXTENSIONS=5
# AUCTION_BID_MIN_INTERVAL_SECONDS=1.0
# AUCTION_RECENT_BIDS_SHOWN=20

# Closure worker and result emails
# AUCTION_WORKER_INTERVAL_SECONDS=5
# AUCTION_NOTIFY_LOSERS=False
# AUCTION_RECENTLY_CLOSED_DAYS=7

# Production only (see docs/DEPLOYMENT.md)
# CSRF_TRUSTED_ORIGINS=https://auction.example.org
# BEHIND_HTTPS_PROXY=True
# SECURE_HSTS_SECONDS=2592000

# Database. PostgreSQL is REQUIRED for correct simultaneous bidding (row locking).
# Without DATABASE_URL the project falls back to SQLite (fine for quick experiments only).
# DATABASE_URL=postgres://sail_user:password@localhost:5432/sail_auction

# Channel layer for WebSockets. Leave unset for one server process (development).
# Several server processes (production) need Redis:
# REDIS_URL=redis://localhost:6379/0
